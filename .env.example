# Copy to .env and replace every placeholder. Never commit .env.

APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-value

# MySQL (matches docker-compose.yml). Use 127.0.0.1, not localhost, to force TCP.
MYSQL_ROOT_PASSWORD=replace-root-password
MYSQL_DATABASE=worker_attendance
MYSQL_USER=wfa_app
MYSQL_PASSWORD=replace-app-password
MYSQL_PORT=3306
DATABASE_URL=mysql+pymysql://wfa_app:replace-app-password@127.0.0.1:3306/worker_attendance?charset=utf8mb4

# Development server. Keep loopback unless you have HTTPS in front (see docs/security-and-privacy.md).
HOST=127.0.0.1
PORT=5000

BUSINESS_TIMEZONE=Asia/Kolkata

# Recognition (face distance; lower = more similar; NOT a confidence percentage)
FACE_MATCH_THRESHOLD=0.50
FACE_AMBIGUITY_MARGIN=0.06
ENROLL_DUPLICATE_THRESHOLD=0.45
ENROLL_MIN_SAMPLES=3
ENROLL_MAX_SAMPLES=8
FACE_DETECTION_MODEL=hog
RECOGNITION_COOLDOWN_SECONDS=20

# Liveness challenge (basic deterrent only, see docs/recognition.md)
LIVENESS_REQUIRED=true
LIVENESS_CHALLENGE_TTL_SECONDS=30

# Biometric retention. Raw enrollment photos are NOT stored unless this is true.
STORE_ENROLLMENT_IMAGES=false
BIOMETRIC_RETENTION_DAYS=30
